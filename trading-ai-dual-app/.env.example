# ============================================================================
# .env.example — modèle de configuration pour trading-ai-dual-app
# ----------------------------------------------------------------------------
# Copiez ce fichier en `.env` et renseignez vos valeurs.
#   cp .env.example .env
#
# RÈGLE ABSOLUE : le fichier `.env` n'est JAMAIS commité (voir .gitignore).
# Créez des clés API avec la permission "trade" UNIQUEMENT, jamais "withdrawal".
# ============================================================================

# ---- Mode de fonctionnement ------------------------------------------------
# Par défaut FALSE = paper trading / testnet (règle non négociable n°1).
# Passer à true NE SUFFIT PAS : il faut AUSSI confirmer dans le dashboard.
LIVE_TRADING=false

# ---- Risk management -------------------------------------------------------
RISK_PER_TRADE=0.02          # 2 % du capital risqué par trade
MAX_DAILY_DRAWDOWN=0.05      # kill-switch si drawdown journalier > 5 %

# ---- Paramètres de trading (modifiables en live via le dashboard) ----------
ACTIVE_PAIRS=BTC/USDT,ETH/USDT
POSITION_SIZE_USD=100
STARTING_CAPITAL=5000        # mise de départ (base du calcul de rendement %)
CONVICTION_THRESHOLD=0.7     # seuil d'exécution auto de l'app-swing
MIN_SPREAD=0.0005            # spread minimal pour l'app-scalp

# ---- Interrupteurs par application -----------------------------------------
SCALP_ENABLED=false
SWING_ENABLED=true

# ---- Clé API Claude (analyse app-swing + agent auto-update) ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Alertes (optionnel : webhook Discord / Slack) -------------------------
ALERT_WEBHOOK_URL=

# ============================================================================
# Clés API par exchange — permission TRADE uniquement, jamais WITHDRAWAL.
# Mettez <EXCHANGE>_ENABLED=true pour activer l'exchange.
# ============================================================================

# ---- Crypto.com ----
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=
CRYPTOCOM_API_PASSWORD=
CRYPTOCOM_ENABLED=false

# ---- Binance ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENABLED=false

# ---- Pionex ----
PIONEX_API_KEY=
PIONEX_API_SECRET=
PIONEX_ENABLED=false

# ---- Bybit ----
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_ENABLED=false

# ---- Kraken ----
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_ENABLED=false
